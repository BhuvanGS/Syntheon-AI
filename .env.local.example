# Database
# CRITICAL: Use Supabase TRANSACTION POOLER (not direct connection) for fast queries
# 
# ✅ CORRECT (Transaction Pooler - Fast ~8ms):
#    postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
#
# ❌ WRONG (Direct Connection - Slow ~500ms+):
#    postgresql://postgres.[ref]:[password]@db.[ref].supabase.co:5432/postgres
#
# Get the Transaction pooler URL from:
# Supabase Dashboard → Settings → Database → Connection Pooling → Transaction mode
DATABASE_URL=your_supabase_pooler_url

# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key

# Skribby Bot
SKRIBBY_API_KEY=your_skribby_api_key
SKRIBBY_WEBHOOK_SECRET=your_skribby_webhook_secret

# Groq AI
GROQ_API_KEY=your_groq_api_key

# Webhooks
WEBHOOK_ACCESS_TOKEN=your_webhook_access_token

# Optional: Ngrok for development
# NGROK_URL=https://your-subdomain.ngrok-free.dev
# Note: When using ngrok, HMR WebSocket will be disabled to prevent connection errors
# You'll need to manually refresh to see code changes
